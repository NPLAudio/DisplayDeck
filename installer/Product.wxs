<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DisplayDeck" Manufacturer="DisplayDeck"
           Version="$(var.Version)" UpgradeCode="D4A7B2E1-5C38-4F96-A1D0-7E3B9C6F2A85"
           Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DisplayDeck is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DisplayDeck">
        <Component Id="TrayExe" Guid="*">
          <File Id="TrayExeFile" Source="stage\DisplayDeck.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start menu shortcut: its own component, keyed by an HKCU value (ICE43/ICE57). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut Id="StartMenuShortcut" Name="DisplayDeck" Description="Switch monitor and audio profiles"
                  Target="[INSTALLFOLDER]DisplayDeck.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DisplayDeck" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- everything except the tray exe (declared above), keeping subfolders -->
      <Files Include="stage\**">
        <Exclude Files="stage\DisplayDeck.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main" Title="DisplayDeck" Level="1" AllowAdvertise="no">
      <ComponentRef Id="TrayExe" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Stop a running tray and its bundled node.exe so files can be replaced or removed.
         Immediate, so it runs in the user's session where the tray lives. -->
    <CustomAction Id="StopApp" Directory="TARGETDIR" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;Get-Process DisplayDeck,node -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*\DisplayDeck\*' } | Stop-Process -Force&quot;" />
    <!-- Start the tray through explorer.exe so it runs with the user's normal rights even when
         the installer itself was elevated (launching it directly would hand it the admin token). -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" Impersonate="yes" Return="asyncNoWait"
                  ExeCommand="explorer.exe &quot;[INSTALLFOLDER]DisplayDeck.exe&quot;" />

    <!-- Inbound rule so a device on the same subnet can reach the server (any network profile,
         because home LANs are often classed "Public"; remoteip=localsubnet keeps it off the internet)
         (only used when "Allow other devices" is switched on in the tray; that mode needs the access key). -->
    <CustomAction Id="FirewallRemove" Directory="TARGETDIR" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall delete rule name=&quot;DisplayDeck&quot;" />
    <CustomAction Id="FirewallRemoveBeforeAdd" Directory="TARGETDIR" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall delete rule name=&quot;DisplayDeck&quot;" />
    <CustomAction Id="FirewallAdd" Directory="TARGETDIR" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall add rule name=&quot;DisplayDeck&quot; dir=in action=allow protocol=TCP localport=8765 profile=any remoteip=localsubnet program=&quot;[INSTALLFOLDER]node\node.exe&quot;" />

    <InstallExecuteSequence>
      <Custom Action="StopApp" After="InstallValidate" Condition="1" />
      <Custom Action="FirewallRemove" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="FirewallRemoveBeforeAdd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="FirewallAdd" After="FirewallRemoveBeforeAdd" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
